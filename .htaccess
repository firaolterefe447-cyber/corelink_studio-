# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/corelink/corelink_studio-"
PassengerBaseURI "/"
PassengerPython "/home/corelink/corelink_studio-/venv/bin/python"
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

# Disable directory indexing
Options -Indexes

# Rewrite rules for static and media files (LiteSpeed compatible)
RewriteEngine On

# Serve static files directly
RewriteRule ^static/(.*)$ /home/corelink/corelink_studio-/staticfiles/$1 [L]

# Serve media files directly
RewriteRule ^media/(.*)$ /home/corelink/corelink_studio-/media/$1 [L]

# Disable Passenger for static and media files
<IfModule mod_passenger.c>
    PassengerEnabled off
</IfModule>
